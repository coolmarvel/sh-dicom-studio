<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShDicomStudio.App.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="ShDicomStudio.App.Controls.StudyBrowserView"
             x:DataType="vm:FindDbViewModel">

    <DockPanel>

        <!-- 검색 대상 탭 (PPW: PACS/내부) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
            <ToggleButton Name="LocalTab" Padding="16,6" CornerRadius="6,6,0,0"
                          IsChecked="True" Click="OnLocalTabClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <i:Icon Value="mdi-laptop" FontSize="14"/><TextBlock Text="내부 (로컬)"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Name="ServerTab" Padding="16,6" CornerRadius="6,6,0,0"
                          Click="OnServerTabClick"
                          ToolTip.Tip="서버(Oracle)의 검사 메타 — 조회 전용, 로그인 필요">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <i:Icon Value="mdi-server" FontSize="14"/><TextBlock Text="서버 (PACS DB)"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,8,*,8,110,8,150,8,150,8,Auto,4,Auto" RowDefinitions="Auto,4,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Patient ID"/>
                <TextBox   Grid.Row="2" Grid.Column="0" Text="{Binding PatientId}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="환자 이름"/>
                <TextBox   Grid.Row="2" Grid.Column="2" Text="{Binding PatientName}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Classes="field" Text="Modality"/>
                <ComboBox  Grid.Row="2" Grid.Column="4" ItemsSource="{Binding ModalityOptions}"
                           SelectedItem="{Binding Modality}" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Classes="field" Text="검사일 (부터)"/>
                <CalendarDatePicker Grid.Row="2" Grid.Column="6" SelectedDate="{Binding FromDate}"
                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                    HorizontalAlignment="Stretch" Watermark="전체"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Classes="field" Text="검사일 (까지)"/>
                <CalendarDatePicker Grid.Row="2" Grid.Column="8" SelectedDate="{Binding ToDate}"
                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                    HorizontalAlignment="Stretch" Watermark="전체"/>
                <Button Grid.Row="2" Grid.Column="10" Command="{Binding SearchCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="White" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-magnify" FontSize="14"/><TextBlock Text="검색"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="12" Command="{Binding ResetCommand}" Padding="14,6"
                        Content="초기화"/>
            </Grid>
        </Border>

        <!-- Modality 퀵필터 (PPW 의 MR/CT/ALL 버튼 줄) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <Button Content="ALL" Command="{Binding QuickFilterCommand}" CommandParameter="ALL" Padding="14,4"/>
            <Button Content="OT" Command="{Binding QuickFilterCommand}" CommandParameter="OT" Padding="14,4"/>
            <Button Content="SC" Command="{Binding QuickFilterCommand}" CommandParameter="SC" Padding="14,4"/>
            <Button Content="VP" Command="{Binding QuickFilterCommand}" CommandParameter="VP" Padding="14,4"/>
            <Button Content="US" Command="{Binding QuickFilterCommand}" CommandParameter="US" Padding="14,4"/>
            <Button Content="ES" Command="{Binding QuickFilterCommand}" CommandParameter="ES" Padding="14,4"/>
            <Button Content="XC" Command="{Binding QuickFilterCommand}" CommandParameter="XC" Padding="14,4"/>
            <Button Content="DX" Command="{Binding QuickFilterCommand}" CommandParameter="DX" Padding="14,4"/>
            <Button Content="CR" Command="{Binding QuickFilterCommand}" CommandParameter="CR" Padding="14,4"/>
        </StackPanel>

        <!-- 하단 버튼 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Background="{StaticResource AccentBrush}" Foreground="White"
                        Padding="16,7" Click="OnOpenClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-folder-open" FontSize="14"/><TextBlock Text="열기"/>
                    </StackPanel>
                </Button>
                <Button Padding="16,7" Click="OnDeleteClick" Content="삭제"/>
            </StackPanel>
        </DockPanel>

        <!-- 결과 목록 -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="1" CornerRadius="8" Padding="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{StaticResource RuleBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="95,110,120,42,48,95,64,*,50,110">
                        <TextBlock Grid.Column="0" Classes="field" Text="검사일" Margin="0"/>
                        <TextBlock Grid.Column="1" Classes="field" Text="Patient ID" Margin="0"/>
                        <TextBlock Grid.Column="2" Classes="field" Text="이름" Margin="0"/>
                        <TextBlock Grid.Column="3" Classes="field" Text="성별" Margin="0"/>
                        <TextBlock Grid.Column="4" Classes="field" Text="나이" Margin="0"/>
                        <TextBlock Grid.Column="5" Classes="field" Text="생년월일" Margin="0"/>
                        <TextBlock Grid.Column="6" Classes="field" Text="장비" Margin="0"/>
                        <TextBlock Grid.Column="7" Classes="field" Text="검사 설명" Margin="0"/>
                        <TextBlock Grid.Column="8" Classes="field" Text="장수" Margin="0"/>
                        <TextBlock Grid.Column="9" Classes="field" Text="저장 시각" Margin="0"/>
                    </Grid>
                </Border>
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}"
                         Background="Transparent" DoubleTapped="OnRowDoubleTapped">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="검사 열기" Click="OnOpenClick">
                                <MenuItem.Icon><i:Icon Value="mdi-folder-open"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="JPG로 내보내기 (정보 오버레이)…" Click="OnExportJpegClick">
                                <MenuItem.Icon><i:Icon Value="mdi-image-move"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="DICOM Storage SCP로 전송…" Click="OnSendClick">
                                <MenuItem.Icon><i:Icon Value="mdi-send"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="검사 삭제" Click="OnDeleteClick">
                                <MenuItem.Icon><i:Icon Value="mdi-delete"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudyRowViewModel">
                            <Grid ColumnDefinitions="95,110,120,42,48,95,64,*,50,110">
                                <TextBlock Grid.Column="0" Text="{Binding StudyDateText}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding PatientId}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding PatientName}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Sex}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{Binding Age}" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="{Binding BirthText}" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="{Binding Modality}" FontSize="12"/>
                                <TextBlock Grid.Column="7" Text="{Binding Description}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="8" Text="{Binding CountText}" FontSize="12"/>
                                <TextBlock Grid.Column="9" Text="{Binding CreatedAtText}" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
