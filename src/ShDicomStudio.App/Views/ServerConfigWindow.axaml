<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="ShDicomStudio.App.Views.ServerConfigWindow"
        Title="서버 설정 (DB Config)"
        Icon="avares://ShDicomStudio.App/Assets/appicon.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}">

    <Grid Margin="16" ColumnDefinitions="*,12,190" RowDefinitions="Auto,*,Auto">

        <!-- 좌: 입력 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">
            <TextBlock Classes="section" Text="SERVER INFORMATION"/>
            <StackPanel>
                <TextBlock Classes="field" Text="서버 이름"/>
                <TextBox Name="NameBox" Watermark="예: 병원 서버"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="field" Text="서버 주소 (URL)"/>
                <TextBox Name="UrlBox" Watermark="예: http://192.168.0.10:8080"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="추가" Click="OnAddClick" Padding="16,6"/>
                <Button Content="수정" Click="OnModifyClick" Padding="16,6"/>
                <Button Content="삭제" Click="OnDeleteClick" Padding="16,6"/>
            </StackPanel>
            <TextBlock Name="StatusBlock" FontSize="11" Foreground="#FFE53935"
                       TextWrapping="Wrap" IsVisible="False"/>
        </StackPanel>

        <!-- 우: 서버 목록 -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Spacing="6">
            <TextBlock Classes="section" Text="SERVER LIST"/>
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="1" CornerRadius="6" Height="220">
                <ListBox Name="ServerList" Background="Transparent"
                         SelectionChanged="OnSelectionChanged"/>
            </Border>
        </StackPanel>

        <!-- 하단 -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인 (저장)" Click="OnOkClick" Padding="18,7"
                    Background="{StaticResource AccentBrush}" Foreground="White"/>
            <Button Content="취소" Click="OnCancelClick" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
