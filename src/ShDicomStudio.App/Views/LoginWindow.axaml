<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="ShDicomStudio.App.Views.LoginWindow"
        Title="sh DICOM Studio — 로그인"
        Icon="avares://ShDicomStudio.App/Assets/appicon.ico"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBrush}">

    <StackPanel Margin="28,24" Spacing="13">
        <!-- 헤더: 로고 + 버전 (PPW 의 "Ver: x.x.x" 참고) -->
        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,2,0,4">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Image Source="avares://ShDicomStudio.App/Assets/appicon.png" Width="34" Height="34"/>
                <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
                    <Run Text="sh " Foreground="{StaticResource BodyTextBrush}"/><Run Text="DICOM Studio" Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>
            </StackPanel>
            <TextBlock Name="VersionBlock" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Text="Ver 0.0.0"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Classes="field" Text="USER ID"/>
            <TextBox Name="UserBox"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Classes="field" Text="PASSWORD"/>
            <TextBox Name="PasswordBox" PasswordChar="●" KeyDown="OnPasswordKeyDown"/>
        </StackPanel>

        <!-- 서버 선택 — 마지막 항목 "서버 설정…" 을 고르면 관리 창이 뜬다 (PPW DB Config) -->
        <StackPanel>
            <TextBlock Classes="field" Text="서버"/>
            <ComboBox Name="ServerCombo" HorizontalAlignment="Stretch"
                      SelectionChanged="OnServerSelectionChanged"/>
        </StackPanel>

        <TextBlock Name="StatusBlock" FontSize="12" Foreground="#FFE53935"
                   TextWrapping="Wrap" IsVisible="False"/>

        <Button Name="LoginButton" Click="OnLoginClick" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{StaticResource AccentBrush}" Foreground="White"
                CornerRadius="8" Padding="0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <i:Icon Value="mdi-login" FontSize="16"/>
                <TextBlock Text="LOG IN" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*,8,*">
            <Button Grid.Column="0" Click="OnOfflineClick" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,8"
                    Content="오프라인으로 계속"/>
            <Button Grid.Column="2" Click="OnExitClick" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,8"
                    Content="종료 (EXIT)"/>
        </Grid>

        <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Text="제작 · 이성현 (SeongHyun Lee) · © 2026 All rights reserved"/>
    </StackPanel>
</Window>
