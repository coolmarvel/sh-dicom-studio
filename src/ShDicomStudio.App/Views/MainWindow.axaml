<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShDicomStudio.App.ViewModels"
        xmlns:controls="using:ShDicomStudio.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ShDicomStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="sh DICOM Studio"
        Width="1200" Height="800">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- 좌측 도구 패널 (VPWinGate Toolbar1 배치 대응 — M2/M3 에서 채워진다) -->
        <Border DockPanel.Dock="Left" Width="210" Background="#FF2D2D30" Padding="8">
            <StackPanel Spacing="12">
                <TextBlock Text="Main Tools" FontWeight="Bold" Foreground="#FFCCCCCC"/>
                <Grid ColumnDefinitions="*,6,*">
                    <Button Grid.Column="0" Name="OpenButton" Content="열기" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Click="OnOpenClick"/>
                    <Button Grid.Column="2" Content="모두 닫기" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Command="{Binding CloseAllCommand}"/>
                </Grid>

                <TextBlock Text="Information" FontWeight="Bold" Foreground="#FFCCCCCC"/>
                <TextBlock Text="환자·검사 정보 입력 (M3 예정)" Foreground="#FF888888"
                           FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Text="Image Tools" FontWeight="Bold" Foreground="#FFCCCCCC"/>
                <TextBlock Text="Rotate/Flip/Invert 등 (M2 예정)" Foreground="#FF888888"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 우측 썸네일 목록 -->
        <Border DockPanel.Dock="Right" Width="150" Background="#FF252526">
            <ListBox ItemsSource="{Binding Images}"
                     SelectedItem="{Binding SelectedImage}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <StackPanel Spacing="2" Margin="0,4">
                            <Image Source="{Binding Bitmap}" Height="90" Stretch="Uniform"/>
                            <TextBlock Text="{Binding FileName}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 하단 상태 바 -->
        <Border DockPanel.Dock="Bottom" Background="#FF2D2D30" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#FF888888" FontSize="12"
                           Text="{Binding SelectedImage.SizeText, FallbackValue=''}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#FFCCCCCC" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- 중앙: 뷰어 툴바 + 이미지 뷰 -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#FF333337" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Fit" Click="OnFitClick"/>
                    <Button Content="실제 크기" Click="OnRealSizeClick"/>
                    <Button Content="초기화" Click="OnResetClick"/>
                    <TextBlock Text="휠: 확대/축소 · 드래그: 이동" Foreground="#FF888888"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
            <controls:ImageViewer Name="Viewer" Source="{Binding SelectedImage.Bitmap, FallbackValue={x:Null}}"/>
        </DockPanel>
    </DockPanel>
</Window>
