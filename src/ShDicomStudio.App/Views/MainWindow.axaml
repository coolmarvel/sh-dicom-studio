<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShDicomStudio.App.ViewModels"
        xmlns:controls="using:ShDicomStudio.App.Controls"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="ShDicomStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="sh DICOM Studio"
        Icon="avares://ShDicomStudio.App/Assets/appicon.ico"
        Width="1400" Height="900"
        Background="{StaticResource ChromeBrush}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 뷰어 셀 — 선택되면 VPWinGate 처럼 빨간 테두리 -->
        <Style Selector="Border.cell">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#22334D"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.cell.selected">
            <Setter Property="BorderBrush" Value="#FFE53935"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ══ 좌측 사이드바 (VPWinGate Toolbar1 대응) ══════════════════ -->
        <Border DockPanel.Dock="Left" Width="316" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 로고 -->
                <Border DockPanel.Dock="Top" Padding="16,14,16,10"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="avares://ShDicomStudio.App/Assets/appicon.png" Width="24" Height="24"/>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
                            <Run Text="sh " Foreground="{StaticResource BodyTextBrush}"/><Run Text="DICOM Studio" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 하단: 저장 버튼 + 저작자 -->
                <Border DockPanel.Dock="Bottom" Padding="16,10,16,12"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <Button IsEnabled="False" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                CornerRadius="8" Padding="0,10"
                                ToolTip.Tip="다음 업데이트(M3)에서 활성화됩니다">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="mdi-content-save" FontSize="16"/>
                                <TextBlock Text="선택 이미지 DICOM 저장" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="DICOM 저장은 다음 업데이트(M3) 예정" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="제작 · 이성현 (SeongHyun Lee)&#x0a;© 2026 All rights reserved"/>
                    </StackPanel>
                </Border>

                <!-- 섹션들 -->
                <ScrollViewer>
                    <StackPanel Margin="16,12" Spacing="14">

                        <!-- ── MAIN TOOLS ─────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,10,*">
                            <TextBlock Classes="section" Text="MAIN TOOLS"/>
                            <Separator Grid.Column="2" Background="{StaticResource RuleBrush}" Height="1"/>
                        </Grid>
                        <UniformGrid Columns="4">
                            <Button Classes="tile" Click="OnOpenClick" ToolTip.Tip="BMP·JPEG·TIFF·DICOM 파일 열기">
                                <StackPanel><i:Icon Value="mdi-folder-open"/><TextBlock Text="Open"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding CloseAllCommand}" ToolTip.Tip="열린 영상·정보 모두 닫기">
                                <StackPanel><i:Icon Value="mdi-close-box"/><TextBlock Text="Close"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="DICOM 파일로 저장 — M3 예정">
                                <StackPanel><i:Icon Value="mdi-content-save"/><TextBlock Text="SaveAs"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="DICOM Worklist 조회 — 4차 예정">
                                <StackPanel><i:Icon Value="mdi-clipboard-text"/><TextBlock Text="Worklist"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="Local DB에 검사 저장 — M4 예정">
                                <StackPanel><i:Icon Value="mdi-database-plus"/><TextBlock Text="SaveDB"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="저장된 검사에 영상 추가 — M4 예정">
                                <StackPanel><i:Icon Value="mdi-account-plus"/><TextBlock Text="InsExam"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="Local DB 검색·열기 — M4 예정">
                                <StackPanel><i:Icon Value="mdi-database-search"/><TextBlock Text="FindDB"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="PACS로 DICOM 전송 — 3차 예정">
                                <StackPanel><i:Icon Value="mdi-send"/><TextBlock Text="Send"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="여러 PACS 동시 전송 — 3차 예정">
                                <StackPanel><i:Icon Value="mdi-broadcast"/><TextBlock Text="Multisend"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="옵션 설정 — M4 예정">
                                <StackPanel><i:Icon Value="mdi-cog"/><TextBlock Text="Option"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="장비 연동 설정 — 보류 (하드웨어 필요)">
                                <StackPanel><i:Icon Value="mdi-connection"/><TextBlock Text="VP I/F"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Click="OnExitClick" ToolTip.Tip="프로그램 종료">
                                <StackPanel><i:Icon Value="mdi-exit-to-app"/><TextBlock Text="Exit"/></StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- ── EXAM INFORMATION ───────────────────── -->
                        <Grid ColumnDefinitions="Auto,10,*">
                            <TextBlock Classes="section" Text="EXAM INFORMATION"/>
                            <Separator Grid.Column="2" Background="{StaticResource RuleBrush}" Height="1"/>
                        </Grid>
                        <TextBlock Text="저장할 DICOM 헤더에 기록됩니다" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <CheckBox IsChecked="{Binding Exam.IsAnonymous}" FontSize="12"
                                  Content="익명 환자 (Anonymous Patient)"/>

                        <StackPanel Spacing="10" IsEnabled="{Binding !Exam.IsAnonymous}">
                            <StackPanel>
                                <TextBlock Classes="field" Text="Patient ID *"/>
                                <Grid ColumnDefinitions="*,6,Auto">
                                    <TextBox Text="{Binding Exam.PatientId}" Watermark="예: 20260001"/>
                                    <Button Grid.Column="2" IsEnabled="False" Padding="8,6"
                                            ToolTip.Tip="Worklist/DB 검색 — 4차 예정">
                                        <i:Icon Value="mdi-magnify" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field" Text="환자 이름 (Name)"/>
                                <TextBox Text="{Binding Exam.PatientName}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="field" Text="성별 (Sex)"/>
                                    <ComboBox ItemsSource="{Binding Exam.SexOptions}"
                                              SelectedItem="{Binding Exam.Sex}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="field" Text="나이 (Age)"/>
                                    <TextBox Text="{Binding Exam.Age}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Classes="field" Text="Modality *"/>
                                    <ComboBox ItemsSource="{Binding Exam.ModalityOptions}"
                                              SelectedItem="{Binding Exam.Modality}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="field" Text="생년월일 (Birthdate)"/>
                                    <CalendarDatePicker SelectedDate="{Binding Exam.BirthDate}"
                                                        SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                        HorizontalAlignment="Stretch" Watermark="날짜 선택"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="field" Text="검사일 (StudyDate) *"/>
                                    <CalendarDatePicker SelectedDate="{Binding Exam.StudyDate}"
                                                        SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                        HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <TextBlock Classes="field" Text="검사 설명 (StudyDescription)"/>
                                <TextBox Text="{Binding Exam.StudyDescription}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="field" Text="Accession No"/>
                                    <TextBox Text="{Binding Exam.AccessionNumber}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="field" Text="담당의 (Referring)"/>
                                    <TextBox Text="{Binding Exam.ReferringPhysician}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <TextBlock Classes="field" Text="코멘트 (Comment)"/>
                                <TextBox Text="{Binding Exam.Comment}" AcceptsReturn="True" MinHeight="56"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding Exam.AutoClear}" FontSize="12"
                                  Content="저장 후 입력란 자동 초기화 (Auto Clear)"/>

                        <!-- ── IMAGE TOOLS ────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,10,*">
                            <TextBlock Classes="section" Text="IMAGE TOOLS"/>
                            <Separator Grid.Column="2" Background="{StaticResource RuleBrush}" Height="1"/>
                        </Grid>
                        <UniformGrid Columns="4">
                            <Button Classes="tile" Command="{Binding RotateCcwCommand}" ToolTip.Tip="반시계 90° 회전">
                                <StackPanel><i:Icon Value="mdi-rotate-left"/><TextBlock Text="Rotate ↺"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding RotateCwCommand}" ToolTip.Tip="시계 90° 회전">
                                <StackPanel><i:Icon Value="mdi-rotate-right"/><TextBlock Text="Rotate ↻"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="좌우 반전">
                                <StackPanel><i:Icon Value="mdi-flip-horizontal"/><TextBlock Text="FlipH"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="상하 반전">
                                <StackPanel><i:Icon Value="mdi-flip-vertical"/><TextBlock Text="FlipV"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding CutCommand}" ToolTip.Tip="순서 변경용 잘라내기">
                                <StackPanel><i:Icon Value="mdi-content-cut"/><TextBlock Text="Cut"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding PasteCommand}" ToolTip.Tip="잘라둔 영상을 선택한 영상 뒤로">
                                <StackPanel><i:Icon Value="mdi-content-paste"/><TextBlock Text="Paste"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="선택 영상 삭제 (복원 불가)">
                                <StackPanel><i:Icon Value="mdi-delete"/><TextBlock Text="Delete"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Command="{Binding InvertCommand}" ToolTip.Tip="색상 반전 (흑↔백)">
                                <StackPanel><i:Icon Value="mdi-invert-colors"/><TextBlock Text="Inverse"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="기본 내장 — 클릭으로 선택">
                                <StackPanel><i:Icon Value="mdi-cursor-default"/><TextBlock Text="Pointer"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="기본 내장 — 드래그로 이동">
                                <StackPanel><i:Icon Value="mdi-pan"/><TextBlock Text="Pan"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="기본 내장 — 휠로 확대/축소">
                                <StackPanel><i:Icon Value="mdi-magnify-plus"/><TextBlock Text="Zoom"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="돋보기 — 예정">
                                <StackPanel><i:Icon Value="mdi-loupe"/><TextBlock Text="Magnify"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Click="OnRealSizeClick" ToolTip.Tip="실제 픽셀 크기로 보기">
                                <StackPanel><i:Icon Value="mdi-aspect-ratio"/><TextBlock Text="Realsize"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Click="OnFitClick" ToolTip.Tip="창 크기에 맞춤">
                                <StackPanel><i:Icon Value="mdi-fit-to-screen"/><TextBlock Text="Fit"/></StackPanel>
                            </Button>
                            <Button Classes="tile" Click="OnResetClick" ToolTip.Tip="보기 초기화">
                                <StackPanel><i:Icon Value="mdi-restore"/><TextBlock Text="Reset"/></StackPanel>
                            </Button>
                            <Button Classes="tile" IsEnabled="False" ToolTip.Tip="장비 폴더에서 이미지 획득 — 보류">
                                <StackPanel><i:Icon Value="mdi-scanner"/><TextBlock Text="VP Scan"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ 우측 썸네일 ═════════════════════════════════════════ -->
        <Border DockPanel.Dock="Right" Width="148" Background="#F8F9FB"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0">
            <ListBox ItemsSource="{Binding Images}"
                     SelectionChanged="OnThumbnailSelectionChanged"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <StackPanel Spacing="2" Margin="0,4">
                            <Border Background="#0E1526" CornerRadius="4" Padding="2">
                                <Image Source="{Binding Bitmap}" Height="84" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding FileName}" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ══ 하단 상태 바 ════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           Text="{Binding SelectedImage.SizeText, FallbackValue=''}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BodyTextBrush}" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- ══ 중앙: 뷰어 툴바 + 그리드 뷰어 ═══════════════════════ -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Name="LayoutButton" Classes="toolbar" ToolTip.Tip="바둑판 레이아웃 선택">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-view-grid" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                                <TextBlock Text="{Binding SelectedLayout.Label}" FontSize="12"
                                           Foreground="{StaticResource BodyTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding ToggleSelectAllCommand}" ToolTip.Tip="현재 페이지 전체 선택/해제">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="mdi-select-all" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                                <TextBlock Text="Select All" FontSize="12"
                                           Foreground="{StaticResource BodyTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Width="1" Height="20" Background="{StaticResource RuleBrush}" Margin="4,0"/>
                        <Button Classes="toolbar" Command="{Binding FirstPageCommand}" ToolTip.Tip="첫 페이지">
                            <i:Icon Value="mdi-page-first" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding PrevPageCommand}" ToolTip.Tip="이전 페이지">
                            <i:Icon Value="mdi-chevron-left" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                        </Button>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,4">
                            <TextBlock FontSize="12" Foreground="{StaticResource BodyTextBrush}">
                                <Run Text="{Binding CurrentPage}" FontWeight="SemiBold"/><Run Text=" / "/><Run Text="{Binding PageCount}"/>
                            </TextBlock>
                        </Border>
                        <Button Classes="toolbar" Command="{Binding NextPageCommand}" ToolTip.Tip="다음 페이지">
                            <i:Icon Value="mdi-chevron-right" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding LastPageCommand}" ToolTip.Tip="마지막 페이지">
                            <i:Icon Value="mdi-page-last" FontSize="16" Foreground="{StaticResource TileIconBrush}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Panel Background="{StaticResource ViewerBgBrush}">
                <ItemsControl ItemsSource="{Binding PageImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ItemsPanelTemplate 안은 컴파일 바인딩 타입 추론이 안 되므로 ReflectionBinding 사용
                                 (패널의 DataContext 는 MainViewModel 을 상속받는다) -->
                            <UniformGrid Rows="{ReflectionBinding SelectedLayout.Rows}"
                                         Columns="{ReflectionBinding SelectedLayout.Cols}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageItemViewModel">
                            <Border Classes="cell" Classes.selected="{Binding IsSelected}"
                                    PointerPressed="OnCellPressed" Background="{StaticResource ViewerBgBrush}">
                                <controls:ImageViewer Source="{Binding Bitmap}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 빈 상태 안내 -->
                <StackPanel IsVisible="{Binding !HasImages}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="8">
                    <i:Icon Value="mdi-image-multiple" FontSize="44" Foreground="#33506E"
                            HorizontalAlignment="Center"/>
                    <TextBlock FontSize="15" Foreground="#B9C6DA" HorizontalAlignment="Center">
                        <Run Text="Open" FontWeight="Bold" Foreground="#E4ECF7"/><Run Text=" 으로 검사 결과를 불러오세요"/>
                    </TextBlock>
                    <TextBlock Text="JPG · PNG · BMP · TIFF · DCM" FontSize="12" Foreground="#7286A2"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>
        </DockPanel>
    </DockPanel>
</Window>
